# 複製成 .env 後修改密碼（.env 不進版控）
MYSQL_ROOT_PASSWORD=change_me_root
APP_DB_USER=banksystem_app
APP_DB_PASSWORD=change_me_app

# 對外 port（避開 80 / 3306）
# 網站監聽的網路介面：127.0.0.1 = 只有本機能連；0.0.0.0 = 區網其他電腦也能連
WEB_BIND=127.0.0.1
WEB_PORT=8088
DB_HOST_PORT=13306

# API 文件（Swagger UI，/api/swagger-ui.html）；正式環境設為 false
SWAGGER_ENABLED=true
